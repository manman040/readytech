# ReadyTech :: environment variables
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Three audiences read this file, and the split matters:
#
#   CLIENT-SAFE   compiled into the Flutter app. Anyone who downloads the app
#                 can extract these, so they are protected by Row Level
#                 Security, not by being hidden.
#   SERVER-ONLY   used by Edge Functions and the admin dashboard's server side.
#                 These grant real authority and must never appear in Flutter
#                 source, in an asset, or in a client bundle.
#   TOOLING       used by the Supabase CLI on a developer machine or in CI.
#
# The Flutter app does not read this file. It takes its values from
# app/env/<flavor>.json via --dart-define-from-file - see app/env/*.example.

# ---------------------------------------------------------------------------
# Supabase :: CLIENT-SAFE
# ---------------------------------------------------------------------------

# Project URL. Local development: http://127.0.0.1:54321
SUPABASE_URL=

# The publishable (anon) key. Designed for client use; RLS is what protects the
# data behind it.
SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Supabase :: SERVER-ONLY
# ---------------------------------------------------------------------------

# Bypasses every Row Level Security policy. Edge Functions and trusted server
# processes only. If this ever reaches a client, every customer record in the
# marketplace is readable and writable by anyone.
SUPABASE_SERVICE_ROLE_KEY=

# Verifies the signature on incoming webhooks.
SUPABASE_JWT_SECRET=

# ---------------------------------------------------------------------------
# Google Maps
# ---------------------------------------------------------------------------

# CLIENT-SAFE, but only because it is restricted. Before shipping, lock this
# key to the Android package name + SHA-1 and the iOS bundle id in the Google
# Cloud console. An unrestricted maps key is a bill waiting to happen.
GOOGLE_MAPS_API_KEY_ANDROID=
GOOGLE_MAPS_API_KEY_IOS=

# SERVER-ONLY. Used by Edge Functions for distance matrix and geocoding calls.
# Restrict by IP, not by referrer.
GOOGLE_MAPS_API_KEY_SERVER=

# ---------------------------------------------------------------------------
# ToyyibPay :: SERVER-ONLY
# ---------------------------------------------------------------------------
#
# Start with the sandbox. Production credentials belong only in the production
# Edge Function secrets - never in a developer's .env, and never in the same
# file as a sandbox key where the two can be confused.
#
# Sandbox: https://dev.toyyibpay.com   Production: https://toyyibpay.com

TOYYIBPAY_BASE_URL=https://dev.toyyibpay.com
TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=

# Where ToyyibPay posts the payment result. Must be publicly reachable and must
# be the only thing that can mark a payment settled.
TOYYIBPAY_CALLBACK_URL=
# Where the customer's browser returns to after paying.
TOYYIBPAY_RETURN_URL=readytech://payment-return

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# development | staging | production
APP_ENV=development

# Enables demo tooling. Ignored entirely in a production build - see
# app/lib/core/config/app_config.dart.
DEMO_MODE=false
