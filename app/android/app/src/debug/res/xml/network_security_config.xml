<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. Referenced from src/debug/AndroidManifest.xml.

  Cleartext HTTP is permitted for exactly two hosts, both of which mean "the
  machine this emulator or device is attached to":

    10.0.2.2   the host, as seen from inside an Android emulator
    localhost  the host, when reached through `adb reverse`

  Everything else - including the hosted Supabase project - still requires
  HTTPS even in a debug build. A blanket cleartextTrafficPermitted="true" would
  also allow an unencrypted connection to the real backend, which is not a
  trade anyone needs to make to run a local database.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
