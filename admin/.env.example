# ReadyTech admin console :: environment
#
# Copy to .env.local and fill in. .env.local is gitignored.
#
# The console signs in as an administrator account and talks to Supabase with
# that account's session, exactly like the mobile app does. So it needs only
# the two CLIENT-SAFE values - the same ones the app is built with - and Row
# Level Security plus the admin_* functions are what grant its authority.
#
# There is deliberately no SUPABASE_SERVICE_ROLE_KEY here. A console holding
# the service role would bypass every policy and every audit entry; the one
# place that key belongs is Edge Functions.

# Local development: http://127.0.0.1:54321  (supabase status)
NEXT_PUBLIC_SUPABASE_URL=

# The publishable (anon) key printed by `supabase start`.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
